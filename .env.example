# =====================================================================================
# IDP Platform configuration. Copy to .env and fill in the values marked REQUIRED.
# Never commit .env.
# =====================================================================================

# ---- Stack ---------------------------------------------------------------------------
# "ollama" starts the local LLM engine (used as the fallback below). Remove to skip it.
COMPOSE_PROFILES=ollama
WEB_PORT=3000            # web app (nginx, also proxies /api)
API_PORT=8000            # API published directly for service-to-service integration
INSTALL_DEV=false        # true adds the test tooling to the images

# ---- Database and queue ---------------------------------------------------------------
DB_USER=idp_user
DB_PASSWORD=change-me-db-password
DB_NAME=idp_db
LOG_LEVEL=INFO           # INFO or DEBUG

# ---- Authentication (REQUIRED) -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false      # set true when the web app is served over HTTPS
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# The first super admin is created from these on first start. Change the password after signing in.
SUPER_ADMIN_EMAIL=admin@idp.local
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Administrator
CORS_ORIGINS=            # comma separated, only needed when another web origin calls the API

# ---- Limits and storage -----------------------------------------------------------------
MAX_UPLOAD_MB=50
SYNC_TIMEOUT_SECONDS=900
STORAGE_MODE=LOCAL       # LOCAL or S3
# S3_BUCKET_NAME=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
FILE_RETENTION_DAYS=7    # redacted outputs are deleted after this many days; originals are never kept

# ---- LLM engines ----------------------------------------------------------------------
# Providers: openai | azure_openai | openai_compatible | anthropic | gemini | ollama
#   openai             URL https://api.openai.com/v1                     MODEL gpt-5-mini
#   azure_openai       URL https://<resource>.openai.azure.com           MODEL <deployment name>, API_VERSION
#   openai_compatible  URL of any OpenAI-protocol server (vLLM, LM Studio, Groq, Together ...)
#   anthropic          URL https://api.anthropic.com                     MODEL claude-opus-5-5
#   gemini             URL https://generativelanguage.googleapis.com      MODEL gemini-4-argon
#   ollama             URL http://ollama:11434                            MODEL qwen3.5:4b
# Each workload has a primary and an optional fallback. When the primary fails (bad credentials,
# outage, exhausted retries) requests switch to the fallback for LLM_FAILOVER_COOLDOWN_SECONDS.

# PHI detection (text)
PHI_LLM_PROVIDER=openai
PHI_LLM_URL=https://api.openai.com/v1
PHI_LLM_MODEL=gpt-5-mini
PHI_LLM_API_KEY=
PHI_LLM_FALLBACK_PROVIDER=ollama
PHI_LLM_FALLBACK_URL=http://ollama:11434
PHI_LLM_FALLBACK_MODEL=qwen3.5:4b
PHI_LLM_CONCURRENCY=16   # model calls in flight per job
PHI_CHUNK_WORDS=4000     # safety ceiling per call: a page is one call unless it exceeds this many words

# Document parsing (vision: figure and chart descriptions)
DOC_LLM_PROVIDER=openai
DOC_LLM_URL=https://api.openai.com/v1
DOC_LLM_MODEL=gpt-5-mini
DOC_LLM_API_KEY=
DOC_LLM_ENABLE_SUMMARY=true
DOC_LLM_FALLBACK_PROVIDER=ollama
DOC_LLM_FALLBACK_URL=http://ollama:11434
DOC_LLM_FALLBACK_MODEL=qwen3.5:4b

# Data extraction (document to JSON). Use a reasoning model; context windows and prices of every
# known model are in shared/model_catalog.json (MODEL_CATALOG_PATH to use another file).
EXTRACT_LLM_PROVIDER=anthropic
EXTRACT_LLM_URL=
EXTRACT_LLM_MODEL=claude-sonnet-5-5
EXTRACT_LLM_API_KEY=
EXTRACT_LLM_FALLBACK_PROVIDER=openai
EXTRACT_LLM_FALLBACK_URL=
EXTRACT_LLM_FALLBACK_MODEL=gpt-6.1-sol
EXTRACT_LLM_FALLBACK_API_KEY=
EXTRACT_REASONING_EFFORT=medium      # low | medium | high
EXTRACT_CONTEXT_THRESHOLD=0.70       # agent sessions are compacted at this share of the usable window
EXTRACT_CONTEXT_CAP_TOKENS=200000    # usable window = min(model window, this); 0 = full model window
EXTRACT_SPEC_MIN_FIELDS=1
EXTRACT_SPEC_MAX_FIELDS=300
EXTRACT_SPEC_MAX_DEPTH=6
EXTRACT_BATCH_CHUNK_TOKENS=60000     # batch approach: largest document part per call
EXTRACT_BATCH_OVERLAP_TOKENS=500
EXTRACT_AGENT_MAX_TURNS=80
EXTRACT_AGENT_MAX_SESSIONS=8
EXTRACT_AGENT_MAX_TOOL_CHARS=12000
EXTRACT_TOC_SCAN_PAGES=10            # pages searched for a table of contents
EXTRACT_TOC_MODE=hybrid             # rules (regex only) | llm | hybrid (rules first, LLM when they find nothing)
EXTRACT_TOC_LLM_PROVIDER=            # engine for index detection; empty = the data extraction engine
EXTRACT_TOC_LLM_MODEL=
EXTRACT_TOC_LLM_URL=
# Engine settings for every service are copied from this file into the database at the first start, then
# administrators change them in the web app (Administration, AI Engines). RUNTIME_CONFIG_SOURCE=env ignores the
# database and always uses these values.
RUNTIME_CONFIG_SOURCE=db
EXTRACT_RAG_CHUNK_TOKENS=450
EXTRACT_RAG_OVERLAP_TOKENS=60
EXTRACT_EMBED_PROVIDER=ollama        # ollama (local) | openai | none (keyword ranking only)
EXTRACT_EMBED_URL=http://ollama:11434
EXTRACT_EMBED_MODEL=qwen3-embedding:0.6b

# Provider keys shared by every workload (a workload's own *_API_KEY wins). A key configured for one
# workload is also reused by the others that use the same provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

LLM_REASONING_EFFORT=low # OpenAI reasoning models and Claude: low | medium | high. See README, accuracy notes.
LLM_TIMEOUT_SECONDS=180
LLM_FAILOVER_COOLDOWN_SECONDS=300
OLLAMA_PULL_MODELS=qwen3.5:4b qwen3-embedding:0.6b   # downloaded by the ollama-init service
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=32768                 # context per local request; 8192 is too small for agentic extraction with a 4B model
OLLAMA_NUM_PARALLEL=2                # parallel requests per model; KV memory = slots x OLLAMA_NUM_CTX
OLLAMA_MAX_LOADED_MODELS=2           # keep the chat model and the embedding model loaded together

# ---- OCR (PaddleOCR 3.7, PP-OCRv6: tiny | small | medium) --------------------------------
OCR_DET_MODEL=PP-OCRv6_small_det
OCR_REC_MODEL=PP-OCRv6_small_rec
PRELOAD_MODELS=ocr       # ocr | all | none (all also preloads the document parsing pipeline)
PHI_RENDER_DPI=150       # page resolution for OCR
PDF_OUTPUT_DPI=200       # page resolution of redacted PDFs
PDF_OUTPUT_JPEG_QUALITY=82
RENDER_WORKERS=2         # page rasterisation processes
OCR_BATCH_PAGES=1
WORKER_CONCURRENCY=3     # jobs one worker runs at the same time (they share the GPU models)
PADDLE_ENABLE_HPI=false
PADDLE_USE_TABLE=true
PADDLE_USE_FORMULA=false
PADDLE_USE_CHART=false
# Optional high-performance inference plugin wheel inside the build context (requires PADDLE_ENABLE_HPI=true)
HPI_WHL_LOCAL=
