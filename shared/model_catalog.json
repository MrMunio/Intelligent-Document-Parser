{
  "schema_version": 1,
  "as_of": "2026-11-18",
  "description": "LLM engines known to the platform: context window, output limit, prices (USD per 1M tokens) and capabilities. Used by the data extraction service to size chunks, decide when an agent session must be compacted, and report cost. The compaction threshold itself is an environment setting (EXTRACT_CONTEXT_THRESHOLD), not part of this file.",
  "sources": {
    "anthropic": "Anthropic Models API (GET /v1/models, max_input_tokens and max_tokens) checked 2026-11-18; prices from the Claude API pricing reference cached 2026-11-03",
    "openai": "https://developers.openai.com/api/docs/pricing and https://developers.openai.com/api/docs/models (gpt-6.2-sol page) checked 2026-11-18; gpt-6-luna, gpt-6.1-terra and gpt-6.1-sol model pages checked 2026-11-18",
    "gemini": "https://aistudio.google.com/docs/pricing and https://aistudio.google.com/docs/models checked 2026-11-18",
    "ollama": "Local models; no token cost. The usable context is limited by OLLAMA_NUM_CTX."
  },
  "field_notes": {
    "context_window": "Total tokens the model accepts (input plus output) according to the provider.",
    "max_input_tokens": "Largest prompt accepted, when the provider publishes it separately from the context window.",
    "max_output_tokens": "Largest completion the model can produce.",
    "pricing": "USD per 1M tokens on the standard tier. cached_input is the price of a prompt-cache read, cache_write the price of writing the cache (Anthropic only).",
    "long_context": "Higher prices that apply to the whole request when the prompt is larger than threshold_tokens.",
    "scheduled_pricing": "Announced price changes; the entry whose effective date has passed replaces the base prices.",
    "context_verified": "true when the context window was confirmed from a first-party source (API or model page); false when it is inferred.",
    "account_models": "Optional per provider: the models this deployment's account may use. When present, only these are offered for selection (configured engines are always allowed); the other entries stay for pricing."
  },
